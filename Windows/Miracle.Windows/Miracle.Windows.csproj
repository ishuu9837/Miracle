<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Miracle</AssemblyName>
    <RootNamespace>Miracle.Windows</RootNamespace>
    <Version>0.3.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-arm64" Version="15.0.0" Condition="'$(RuntimeIdentifier)' != 'win-x64'" />
    <PackageReference Include="Magick.NET-Q8-x64" Version="15.0.0" Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
    <PackageReference Include="PDFsharp-WPF" Version="6.2.4" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="157.0.8100" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>
  <ItemGroup><Content Include="..\TestFixtures\archive-stored.rar" Link="TestFixtures\archive-stored.rar" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Resource Include="Assets\AppIcon.png" /></ItemGroup>
</Project>
